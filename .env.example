# The React app does NOT need financial API keys.
# Visitors only read /data/latest.json.
# Put provider keys/endpoints in GitHub Actions Secrets instead.

# GitHub Actions secret:
# TWELVE_DATA_KEY=
# IPO_JSON_URL=
# GMP_JSON_URL=
# FIIDI_JSON_URL=
# NEWS_JSON_URL=

# GitHub Actions repository variables (optional symbol overrides):
# NIFTY_SYMBOL=NSE:NIFTY
# SENSEX_SYMBOL=BSE:SENSEX
# BANK_NIFTY_SYMBOL=NSE:BANKNIFTY
# GIFT_NIFTY_SYMBOL=
# SP500_SYMBOL=SPX
# NASDAQ_SYMBOL=NDX
# FTSE_SYMBOL=FTSE
# HANGSENG_SYMBOL=HSI
# USDINR_SYMBOL=USD/INR
# GOLD_SYMBOL=XAU/USD
# SILVER_SYMBOL=XAG/USD
# BRENT_SYMBOL=BRENT/USD
# WTI_SYMBOL=WTI/USD
# NATURAL_GAS_SYMBOL=NG/USD
