# Required scheduled refresh API credentials
TWELVE_DATA_KEY=

# Twelve Data symbols (override defaults if your plan/provider uses different symbols)
NIFTY_SYMBOL=NSE:NIFTY
SENSEX_SYMBOL=BSE:SENSEX
BANK_NIFTY_SYMBOL=NSE:BANKNIFTY
GIFT_NIFTY_SYMBOL=
SP500_SYMBOL=SPX
NASDAQ_SYMBOL=NDX
FTSE_SYMBOL=FTSE
HANGSENG_SYMBOL=HSI
USDINR_SYMBOL=USD/INR
GOLD_SPOT_SYMBOL=XAU/USD
SILVER_SPOT_SYMBOL=XAG/USD
BRENT_SYMBOL=XBR/USD
WTI_SYMBOL=WTI/USD
NATURAL_GAS_SYMBOL=XNG/USD

# Optional direct INR metal APIs. If absent, live XAU/XAG + live USD/INR are converted.
GOLD_INR_URL=
SILVER_INR_URL=

# REQUIRED normalized JSON feeds. These are API endpoints, not snapshots.
IPO_JSON_URL=
GMP_JSON_URL=
FIIDI_JSON_URL=
STOCKS_JSON_URL=
NEWS_JSON_URL=
