// IMPORTANT: before config-driven deployment, add the existing MARKET_CACHE KV binding with its real account-specific namespace ID. A dashboard-only binding may be replaced by this config. See LIVE-DATA-SETUP.md.
{
  "name": "bazaarbrief",
  "main": "./worker/src/index.ts",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://bazaarbrief.in",
    "PUBLIC_ORIGIN": "https://bazaarbrief.in"
  }
}
